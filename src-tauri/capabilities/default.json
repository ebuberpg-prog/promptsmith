{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Native storage capabilities for the main MUSE window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-applocaldata-write-recursive",
    "sql:default",
    "sql:allow-execute"
  ]
}
